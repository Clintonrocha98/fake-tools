APP_NAME=Sycorax
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Etc/UTC
APP_SCHEDULE_TIMEZONE=America/Sao_Paulo
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
NIGHTWATCH_ENABLED=false
BACKUP_ENABLED=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

LARAVEL_CLOUDFLARE_ENABLED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco: a instância Postgres do brd-digital (container `brd-db`), reusada.
#     Este projeto NÃO sobe container de banco próprio — sobe o `brd-db` pelo
#     compose do brd-digital e cria os dois databases uma vez:
#
#       docker exec brd-db psql -U postgres \
#           -c 'CREATE DATABASE dev_fake_binance' \
#           -c 'CREATE DATABASE test_fake_binance'
#
#     `DB_PORT` é a porta que o `brd-db` publica no host, e ela varia por
#     máquina (outro container pode já estar na 5432). Confira com
#     `docker port brd-db`. Rodando este projeto DENTRO da rede dev-brd, use
#     DB_HOST=brd-db e DB_PORT=5432 (ver docker-compose.yml). ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dev_fake_binance
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@localhost.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Contrato de env do fake (ver README.md § Env contract) -----------------

# Assinatura (config/venue.php). O par abaixo valida o HMAC dos requests —
# deve espelhar o BINANCE_API_KEY/SECRET configurado no monolito consumidor.
FAKE_BINANCE_API_KEY=fake-binance-local-key
FAKE_BINANCE_API_SECRET=fake-binance-local-secret
# Janela (ms) aceita entre o timestamp do request e o horário do servidor
# quando o request não manda `recvWindow`. Teto de 60000 imposto no middleware.
FAKE_BINANCE_RECV_WINDOW=5000

# Ledger (config/fake-binance-ledger.php). Saldos de partida, aplicados pelo seeder.
# Formato: lista separada por vírgula de ASSET:AMOUNT.
FAKE_BINANCE_SEED_BALANCES=BRL:100000,USDT:5000

# Fiat (config/fake-binance-fiat.php).
FAKE_BINANCE_FIAT_ADVANCE_SECONDS=60
FAKE_BINANCE_FIAT_STATUS_DIALECT=live
FAKE_BINANCE_FIAT_DEPOSIT_ENABLED=true
FAKE_BINANCE_FIAT_SUPPORTED_CURRENCY=BRL
FAKE_BINANCE_FIAT_SUPPORTED_PAYMENT_METHOD=Pix
# Teto de `amount` por depósito, decimal-string. Vazio/ausente = sem teto;
# um valor acima do teto recusa com -16007.
# FAKE_BINANCE_FIAT_DEPOSIT_LIMIT=

# Spot (config/fake-binance-spot.php). `PRICE` é o mid do par USDCBRL e `SPREAD` a
# largura bid/ask em torno dele — preço fixo por env é a fonte (ADR-0002).
FAKE_BINANCE_USDCBRL_PRICE=5.10
FAKE_BINANCE_USDCBRL_SPREAD=0.02
FAKE_BINANCE_SPOT_COMMISSION_RATE=0.001

# Withdraw (config/fake-binance-withdraw.php). As taxas por rede não são env — vivem
# no array `fees` do config, porque rede fora do mapa é recusada de propósito.
FAKE_BINANCE_WITHDRAW_ADVANCE_SECONDS=60
