APP_NAME="Fake Tools"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Etc/UTC
APP_SCHEDULE_TIMEZONE=America/Sao_Paulo
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
NIGHTWATCH_ENABLED=false
BACKUP_ENABLED=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

LARAVEL_CLOUDFLARE_ENABLED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco: a instância Postgres do brd-digital (container `brd-db`), reusada.
#     Este projeto NÃO sobe container de banco próprio — sobe o `brd-db` pelo
#     compose do brd-digital e cria os dois databases uma vez:
#
#       docker exec brd-db psql -U postgres \
#           -c 'CREATE DATABASE dev_fake_tools' \
#           -c 'CREATE DATABASE test_fake_tools'
#
#     `DB_PORT` é a porta que o `brd-db` publica no host, e ela varia por
#     máquina (outro container pode já estar na 5432). Confira com
#     `docker port brd-db`. Rodando este projeto DENTRO da rede dev-brd, use
#     DB_HOST=brd-db e DB_PORT=5432 (ver docker-compose.yml). ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dev_fake_tools
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@localhost.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Contrato de env do fake (ver README.md § Env contract) -----------------

# Assinatura (config/venue.php). O par abaixo valida o HMAC dos requests —
# deve espelhar o BINANCE_API_KEY/SECRET configurado no monolito consumidor.
FAKE_BINANCE_API_KEY=fake-binance-local-key
FAKE_BINANCE_API_SECRET=fake-binance-local-secret
# Janela (ms) aceita entre o timestamp do request e o horário do servidor
# quando o request não manda `recvWindow`. Teto de 60000 imposto no middleware.
FAKE_BINANCE_RECV_WINDOW=5000

# Ledger (config/fake-binance-ledger.php). Saldos de partida, aplicados pelo seeder.
# Formato: lista separada por vírgula de ASSET:AMOUNT.
FAKE_BINANCE_SEED_BALANCES=BRL:100000,USDT:5000

# Fiat (config/fake-binance-fiat.php).
FAKE_BINANCE_FIAT_ADVANCE_SECONDS=60
FAKE_BINANCE_FIAT_STATUS_DIALECT=live
FAKE_BINANCE_FIAT_DEPOSIT_ENABLED=true
FAKE_BINANCE_FIAT_SUPPORTED_CURRENCY=BRL
FAKE_BINANCE_FIAT_SUPPORTED_PAYMENT_METHOD=Pix
# Teto de `amount` por depósito, decimal-string. Vazio/ausente = sem teto;
# um valor acima do teto recusa com -16007.
# FAKE_BINANCE_FIAT_DEPOSIT_LIMIT=
# BR Code EMV estático servido no `pixcode`. A chave PIX é metade do contrato
# entre os dois fakes: precisa ser idêntica a FAKE_STARKBANK_FUNDING_PIX_KEY,
# que é quem o preview do fake-starkbank resolve no registro DICT. O valor do
# BR Code (campo 54) nunca é env — sai sempre do `amount` da ordem.
FAKE_BINANCE_FIAT_PIX_KEY=funding@fake-binance.dev
FAKE_BINANCE_FIAT_MERCHANT_NAME="Fake Binance"
FAKE_BINANCE_FIAT_MERCHANT_CITY="Sao Paulo"

# Spot (config/fake-binance-spot.php). `PRICE` é o mid de cada par servido e `SPREAD`
# a largura bid/ask em torno dele — preço fixo por env é a fonte (ADR-0002, por símbolo).
FAKE_BINANCE_USDCBRL_PRICE=5.10
FAKE_BINANCE_USDCBRL_SPREAD=0.02
FAKE_BINANCE_USDTBRL_PRICE=5.10
FAKE_BINANCE_USDTBRL_SPREAD=0.02
FAKE_BINANCE_SPOT_COMMISSION_RATE=0.001
# Livro sintético de GET /api/v3/depth: N níveis por lado, afastando-se STEP
# por nível a partir do bid/ask (ADR-0002 — previsível, sem volatilidade).
FAKE_BINANCE_DEPTH_LEVELS=5
FAKE_BINANCE_DEPTH_STEP=0.01

# Withdraw (config/fake-binance-withdraw.php). As taxas por rede não são env — vivem
# no array `fees` do config, porque rede fora do mapa é recusada de propósito.
FAKE_BINANCE_WITHDRAW_ADVANCE_SECONDS=60

# Depósito cripto (config/fake-binance-deposit.php). Uma chegada é semeada por
# `php artisan fake-binance:announce-deposit` e avança 0 Pending → 6 Credited →
# 1 Success pela idade contra ADVANCE_SECONDS, creditando o ledger ao entrar em
# Credited (ADR-0003). Os endereços por rede também são config
# (fake-binance-deposit.addresses); rede fora do mapa é recusada.
FAKE_BINANCE_DEPOSIT_ADVANCE_SECONDS=60

# Travel rule (config/fake-binance.php). Vazio/ausente = sem exigência de
# questionário (happy path da entrega em carteira). Um país (ex.: BR) faz o
# consumidor recusar a entrega antes de qualquer saque; NIL = sem exigência.
# FAKE_BINANCE_TRAVEL_RULE_COUNTRY=

# --- fake-starkbank (config/fake-starkbank.php) -----------------------------

# Autenticação (config/fake-starkbank.php). O access_id deve casar com
# STARKBANK_ACCESS_ID configurado no monolito consumidor; o par de chaves
# ECDSA de dev vive em docker/dev-keys/ (ver README.md do fake-starkbank).
# O PEM entra por arquivo (preferido) ou inline; sem chave legível, TODA
# assinatura é recusada com invalidSignature.
FAKE_STARKBANK_CLIENT_ACCESS_ID=project/6341320293482496
FAKE_STARKBANK_CLIENT_PUBLIC_KEY_PATH=docker/dev-keys/client-dev.pub.pem
# FAKE_STARKBANK_CLIENT_PUBLIC_KEY=

# Tolerância (segundos) entre o Access-Time do request e o relógio do fake.
# Reduzir é o gancho para armar expiredAccessTime sob comando.
FAKE_STARKBANK_RECV_WINDOW_SECONDS=300

# Webhook (config/fake-starkbank.php). O fake assina cada entrega com a chave
# privada abaixo; a URL é o endpoint do CONSUMIDOR — do host, se o monolito
# roda fora do compose (ver README.md § "Pointing the monolith at it").
FAKE_STARKBANK_WEBHOOK_URL=http://host.docker.internal:8000/webhooks/starkbank
FAKE_STARKBANK_WEBHOOK_PRIVATE_KEY_PATH=docker/dev-keys/webhook-dev.pem
# FAKE_STARKBANK_WEBHOOK_PRIVATE_KEY=
# Timeout (segundos) da entrega POST pós-resposta.
FAKE_STARKBANK_WEBHOOK_TIMEOUT_SECONDS=5

# Workspace servido por GET /v2/workspace, em página única (cursor sempre null).
# Os defaults espelham verbatim o fixture do consumidor; um `status` diferente de
# `active` ou uma lista de tax ids vazia são cenários armados por aqui.
FAKE_STARKBANK_WORKSPACE_ID=6341320293482496
FAKE_STARKBANK_WORKSPACE_USERNAME=brd-treasury
FAKE_STARKBANK_WORKSPACE_NAME="BRD Treasury"
FAKE_STARKBANK_WORKSPACE_ALLOWED_TAX_IDS=20.018.183/0001-80
FAKE_STARKBANK_WORKSPACE_STATUS=active
FAKE_STARKBANK_WORKSPACE_ORGANIZATION_ID=5716662276096000
FAKE_STARKBANK_WORKSPACE_PICTURE_URL=https://s3.amazonaws.com/starkbank/workspaces/brd-treasury.png
# Vazio/ausente = o instante do boot do processo.
# FAKE_STARKBANK_WORKSPACE_CREATED=

# Avanço lazy por subsistema (config/fake-starkbank-{invoice,transfer,brcode}.php).
FAKE_STARKBANK_INVOICE_ADVANCE_SECONDS=60
FAKE_STARKBANK_TRANSFER_ADVANCE_SECONDS=60
FAKE_STARKBANK_BRCODE_ADVANCE_SECONDS=60

# Preview de brcode-payment (config/fake-starkbank-brcode.php). Ecoados
# verbatim no GET /v2/brcode-preview.
FAKE_STARKBANK_BRCODE_RECONCILIATION_ID=recon-9f2c
FAKE_STARKBANK_BRCODE_DESCRIPTION="Invoice 2026-07"

# DICT (config/fake-starkbank-dict.php). Beneficiário de referência, seedado
# a partir do fixture do consumidor.
FAKE_STARKBANK_DICT_REFERENCE_PIX_KEY=ada@brd.digital
FAKE_STARKBANK_DICT_REFERENCE_TYPE=email
FAKE_STARKBANK_DICT_REFERENCE_NAME="Ada Lovelace"
FAKE_STARKBANK_DICT_REFERENCE_TAX_ID=012.345.678-90
FAKE_STARKBANK_DICT_REFERENCE_OWNER_TYPE=naturalPerson
FAKE_STARKBANK_DICT_BANK_NAME="Stark Bank S.A."
FAKE_STARKBANK_DICT_ISPB=20018183
FAKE_STARKBANK_DICT_ACCOUNT_TYPE=checking
FAKE_STARKBANK_DICT_STATUS=registered

# Destino seedado da funding (config/fake-starkbank-dict.php). Contrato
# cruzado entre os dois fakes: precisa ser idêntica a FAKE_BINANCE_FIAT_PIX_KEY,
# que é a chave PIX embutida no BR Code EMV do fake-binance; o taxId deve casar
# com TREASURY_CONVERSION_FUNDING_EXPECTED_TAX_ID no consumidor, ou o segundo
# lock de destino de SendConversionFunding recusa o pagamento fail-closed.
FAKE_STARKBANK_FUNDING_PIX_KEY=funding@fake-binance.dev
FAKE_STARKBANK_FUNDING_TAX_ID=20.018.183/0001-80
FAKE_STARKBANK_FUNDING_NAME="Fake Binance"

# --- Plano de controle (config/control.php) --------------------------------
#
# O grupo de rotas /control que o monolito consumidor usa em dev para OBSERVAR
# (feed e snapshot) e DIRIGIR (cenários, switchboard, comandos por recurso) os
# dois fakes por HTTP, sem docker exec e sem o painel Filament aberto ao lado.
#
# Desligado, as rotas NEM REGISTRAM (404) — o comando `control:reset-baseline`
# continua funcionando.
FAKE_TOOLS_CONTROL_ENABLED=true
# Página e teto do cursor de `GET /control/feed`.
FAKE_TOOLS_CONTROL_FEED_DEFAULT_LIMIT=100
FAKE_TOOLS_CONTROL_FEED_MAX_LIMIT=500
# Telemetria de dev, não auditoria: `model:prune` apaga o que passar da janela.
FAKE_TOOLS_CONTROL_FEED_RETENTION_HOURS=24
# Quantos registros recentes cada tipo traz em `GET /control/state`.
FAKE_TOOLS_CONTROL_STATE_RECENT_LIMIT=10
# Conexão do produtor do feed. Mesmo banco, conexão própria: o handler escreve
# em autocommit, fora da transação da Action que logou — senão todo caminho que
# dá rollback sumiria do feed. Só troque para a conexão default em teste.
FAKE_TOOLS_CONTROL_CONNECTION=control
