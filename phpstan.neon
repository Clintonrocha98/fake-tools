includes:
    - phpstan.modules.php
    - phpstan.ignore.neon

parameters:
    level: 7
    checkImplicitMixed: true

    # Project-local result cache so CI can persist resultCache.php across runs
    # (see _phpstan.yml). Grouped with the other tool caches under .cache/.
    tmpDir: .cache/phpstan

    paths:
        - app

    # Verbatim copy of Pest's internal Shard plugin (only the discovery regex is
    # patched). Treated as third-party code — kept re-syncable with upstream.
    excludePaths:
        - app/Support/PestShardPlugin.php
