APP_NAME="Fake Tools"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Etc/UTC
APP_SCHEDULE_TIMEZONE=America/Sao_Paulo
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Faster hashing for the test suite
BCRYPT_ROUNDS=4

DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
NIGHTWATCH_ENABLED=false
BACKUP_ENABLED=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

LARAVEL_CLOUDFLARE_ENABLED=false

LOG_CHANNEL=null
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco de teste: mesma instância Postgres do dev (container `brd-db` do
#     brd-digital), database separado. Copiado para .env.testing (UNTRACKED)
#     pelo post-root-package-install — ajuste `DB_PORT` para a porta que o
#     `brd-db` publica na SUA máquina (`docker port brd-db`).
#
#     `pest --parallel` cria um database por worker a partir deste nome
#     (test_fake_tools_test_1, _2, …), como o brd-digital já faz. ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=test_fake_tools
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
# CACHE_PREFIX=

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@localhost.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Par usado para validar a assinatura HMAC dos requests que chegam ao fake —
# deve espelhar o par BINANCE_API_KEY/BINANCE_API_SECRET configurado no
# monolito consumidor (dev/testing).
FAKE_BINANCE_API_KEY=test-api-key
FAKE_BINANCE_API_SECRET=test-api-secret
